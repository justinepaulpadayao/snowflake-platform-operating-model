[sqlfluff]
dialect = snowflake
templater = raw
large_file_skip_byte_limit = 0
max_line_length = 120
# Exclude cosmetic layout and capitalisation rules; Snowflake convention uses
# uppercase types and keywords, and line-length/indent style is handled by review
# SQL formatting conventions rather than strict linter enforcement.
exclude_rules = LT05, LT02, LT01, LT09, LT12, CP01, CP02, CP03, CP05, RF02, RF03, AL01, AL08, ST06, AM04

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
